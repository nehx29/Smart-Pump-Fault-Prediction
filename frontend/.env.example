# Smart Pump Frontend Configuration
# Copy this file to .env.local and adjust as needed.

# API base URL — defaults to /api (uses Vite dev proxy to Flask on port 5000)
# For production or direct backend access, set to full URL:
#   VITE_API_URL=http://127.0.0.1:5000/api
#   VITE_API_URL=https://your-tunnel.trycloudflare.com/api
VITE_API_URL=/api
